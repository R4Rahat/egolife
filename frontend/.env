# Services Page API Configuration
# To use live API data on the /services page, set the API URL below.
# If VITE_SERVICES_API_URL is empty or commented out, the application falls back to the default local services data.
VITE_SERVICES_API_URL=https://jsonplaceholder.typicode.com/posts
VITE_SERVICES_API_KEY=egolife_secure_api_key_2026

# Notifications Page API Configuration
# Set VITE_NOTIFICATIONS_API_URL to fetch public notices & circulars from an API.
VITE_NOTIFICATIONS_API_URL=https://jsonplaceholder.typicode.com/posts
VITE_NOTIFICATIONS_API_KEY=egolife_notifications_key_2026

# Apps & Downloads Page API Configuration
# Set VITE_APPS_API_URL to fetch downloadable apps list from backend server.
VITE_APPS_API_URL=
VITE_APPS_API_KEY=egolife_apps_key_2026
